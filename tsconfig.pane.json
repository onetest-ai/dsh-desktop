{
  "//": "The pane renderer: browser code, bundled by esbuild rather than emitted by tsc, so this face only typechecks it.",
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true
  },
  "include": ["src/renderer/pane/**/*.ts"]
}
