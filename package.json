{
  "name": "dsh-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Desktop shell for a local DeepSeek Harness checkout",
  "main": "dist/main/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json && npm run build:renderer",
    "build:renderer": "mkdir -p dist/renderer && cp src/renderer/settings.html src/renderer/settings.css src/renderer/settings.js src/renderer/startup.html src/renderer/startup.js src/renderer/splash.png dist/renderer/",
    "test": "vitest run",
    "start": "npm run build && electron .",
    "pack": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder",
    "test:smoke": "playwright test tests/smoke.spec.ts",
    "release": "npm run build && electron-builder --mac dmg -c.mac.notarize=true --publish never"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.0.0",
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "build": {
    "appId": "com.onetest.dsh-desktop",
    "productName": "DeepSeek Harness",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "asar": true,
    "files": [
      "dist/**/*",
      "assets/**/*",
      "node_modules/js-yaml/**/*",
      "node_modules/argparse/**/*"
    ],
    "extraMetadata": {
      "main": "dist/main/index.js"
    },
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "assets/icon.icns",
      "target": [
        "dir",
        "dmg"
      ],
      "hardenedRuntime": true,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "protocols": [
        {
          "name": "dsh",
          "schemes": [
            "dsh"
          ]
        }
      ]
    },
    "afterPack": "build/adhoc-sign.js"
  },
  "dependencies": {
    "js-yaml": "^4.3.1"
  },
  "license": "MIT",
  "author": "OneTest AI",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/onetest-ai/dsh-desktop.git"
  },
  "homepage": "https://github.com/onetest-ai/dsh-desktop#readme",
  "bugs": {
    "url": "https://github.com/onetest-ai/dsh-desktop/issues"
  },
  "keywords": [
    "electron",
    "deepseek",
    "deepseek-harness",
    "desktop",
    "macos",
    "mcp",
    "agent"
  ],
  "engines": {
    "node": ">=22"
  }
}
